<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DailyTide" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.DailyTide.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FAF8F4</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground_brand</item>
        <item name="windowSplashScreenIconBackgroundColor">#FFFFFF</item>
        <item name="postSplashScreenTheme">@style/Theme.DailyTide</item>
    </style>
</resources>
